{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitemap-opportunity-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 21 * * *", "*/5 * * * *", "0 13 * * 1"]
  },
  "kv_namespaces": [
    {
      "binding": "SNAPSHOTS",
      "id": "2f2d09e41c4a4d21b5337580689b35d8"
    }
  ],
  "vars": {
    "TRENDS_KEYWORDS": "[{\"keyword\":\"Stairs Sort\"},{\"keyword\":\"Mystery Dumpling: Unbox ASMR\"},{\"keyword\":\"Pirate Cannon Blast\"},{\"keyword\":\"Car Sort: Pixel Color Puzzle\"},{\"keyword\":\"Sand Traffic Fever\"},{\"keyword\":\"Connect Tracks: Logic Puzzle\"},{\"keyword\":\"Block Puzzle: Colors Blast\"},{\"keyword\":\"Cat Match\"},{\"keyword\":\"Cat Home Match\"},{\"keyword\":\"Worm Maze: Logic Puzzle\"},{\"keyword\":\"Color Sort Puzzle: Loopy Doopy\"},{\"keyword\":\"Card Pop: Category Sort\"}]",
    "TRENDS_NOISE_FLOOR": "3",
    "TRENDS_DOUBLING_FACTOR": "2",
    "MAX_AITDK_DOMAINS_PER_RUN": "15",
    "MAX_NEW_PAGES": "20",
    "MAX_SITEMAPS_PER_SITE": "50",
    "MONITORED_SITEMAPS": "[{\"id\":\"aihotwords\",\"name\":\"AI Hot Words\",\"url\":\"https://aihotwords.com/sitemap.xml\",\"pathPrefix\":\"https://aihotwords.com/t/\",\"primaryLanguage\":\"en\"},{\"id\":\"aivideotrend\",\"name\":\"AIVideoTrend\",\"url\":\"https://aivideotrend.net/sitemap.xml\",\"primaryLanguage\":\"en\",\"focusPathPrefix\":\"https://aivideotrend.net/effects/\"},{\"id\":\"stddevcalc\",\"name\":\"StandardDeviationCalculator\",\"url\":\"https://www.standarddeviationcalculator.io/sitemap.xml\"},{\"id\":\"mage\",\"name\":\"MageSpace\",\"url\":\"https://www.mage.space/sitemap.xml\"},{\"id\":\"lipsync\",\"name\":\"LipSyncVideo\",\"url\":\"https://lipsync.video/sitemap.xml\"},{\"id\":\"photoroom\",\"name\":\"PhotoRoom\",\"url\":\"https://www.photoroom.com/sitemap/en.xml\"},{\"id\":\"soulvirtues\",\"name\":\"SoulVirtues\",\"url\":\"https://soulvirtues.com/sitemap.xml\"},{\"id\":\"pmkg\",\"name\":\"PMKG 新提交网站\",\"url\":\"https://www.pmkg.net/wp-sitemap.xml\",\"pathPrefix\":\"https://www.pmkg.net/sites/\",\"analyzeLinkedSite\":true},{\"id\":\"creem\",\"name\":\"Creem 新公开商店\",\"url\":\"https://www.creem.io/sitemap.xml\",\"pathPrefix\":\"https://www.creem.io/stores/\",\"analyzeLinkedSite\":true}]"
  }
}
