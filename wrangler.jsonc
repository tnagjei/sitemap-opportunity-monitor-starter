{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitemap-opportunity-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": true,
  "triggers": {
    "crons": ["0 21 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "SNAPSHOTS",
      "id": "2f2d09e41c4a4d21b5337580689b35d8"
    }
  ],
  "vars": {
    "MAX_NEW_PAGES": "20",
    "MAX_SITEMAPS_PER_SITE": "50",
    "MONITORED_SITEMAPS": "[{\"id\":\"picmonkey\",\"name\":\"PicMonkey\",\"url\":\"https://www.picmonkey.com/sitemap.xml\"},{\"id\":\"namethatui\",\"name\":\"NameThatUI\",\"url\":\"https://namethatui.com/sitemap.xml\"},{\"id\":\"inchcalculator\",\"name\":\"InchCalculator\",\"url\":\"https://www.inchcalculator.com/sitemap_index.xml\"},{\"id\":\"omnicalculator\",\"name\":\"OmniCalculator\",\"url\":\"https://www.omnicalculator.com/sitemap.xml\"},{\"id\":\"imagy\",\"name\":\"Imagy\",\"url\":\"https://imagy.app/sitemap.xml\"},{\"id\":\"vsco\",\"name\":\"VSCO\",\"url\":\"https://www.vsco.co/sitemap.xml\"},{\"id\":\"stddevcalc\",\"name\":\"StandardDeviationCalculator\",\"url\":\"https://www.standarddeviationcalculator.io/sitemap.xml\"},{\"id\":\"goodcalculators\",\"name\":\"GoodCalculators\",\"url\":\"https://goodcalculators.com/sitemap.xml\"},{\"id\":\"mage\",\"name\":\"MageSpace\",\"url\":\"https://www.mage.space/sitemap.xml\"},{\"id\":\"lipsync\",\"name\":\"LipSyncVideo\",\"url\":\"https://lipsync.video/sitemap.xml\"},{\"id\":\"makeinfluencer-guides\",\"name\":\"MakeInfluencer Guides\",\"url\":\"https://www.makeinfluencer.ai/sitemaps/en/guides.xml\"},{\"id\":\"makeinfluencer-aimodels\",\"name\":\"MakeInfluencer AI Models\",\"url\":\"https://www.makeinfluencer.ai/sitemaps/en/ai-models.xml\"},{\"id\":\"mew\",\"name\":\"MewDesign\",\"url\":\"https://mew.design/sitemap.xml\"}]"
  }
}
